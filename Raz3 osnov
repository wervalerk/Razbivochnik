        "• <b>Пропустить</b> → сразу готовый TXT с последними настройками\n\n"
        "✅ 3D‑полилинии: свой Z у каждой вершины; у 2D берётся `elevation`.",
        parse_mode="HTML"
    )

@dp.message(F.document)
async def handle_dxf(msg: Message):
    if not (msg.document.file_name or "").lower().endswith(".dxf"):
        await msg.answer("⚠️ Нужен файл .dxf")
        return

    uid = msg.from_user.id
    AWAIT_CODE.discard(uid)
    tmp = f"in_{uid}.dxf"
    await msg.answer("⏳ Читаю полилинии (в т.ч. 3D)...")

    try:
        f = await bot.get_file(msg.document.file_id)
        await bot.download_file(f.file_path, destination=tmp)
        rows, stats, groups = read_vertices(tmp)
    except Exception as e:
        await msg.answer(f"❌ Не удалось прочитать DXF: {e}")
        return
    finally:
        if os.path.exists(tmp):
            os.remove(tmp)

    if not rows:
        await msg.answer("⚠️ Вершин не найдено. Если контур в блоке — "
                         "<code>INCLUDE_BLOCKS = True</code> в начале скрипта.",
                         parse_mode="HTML")
        return

    PENDING[uid] = {"rows": rows, "groups": groups, "stats": stats,
                    "chat_id": msg.chat.id, "preview_id": None, "menu_id": None}
    s = SETTINGS.setdefault(uid, DEFAULT.copy())

    if not PIL_OK:
        await msg.answer("ℹ️ Для превью: <code>pip install Pillow</code>. Пока сразу настройки.",
                         parse_mode="HTML")
        await show_settings(msg.chat.id, uid)
        return

    try:
        png, meta = render_preview(rows, groups, s)
        ph = await msg.answer_photo(
            BufferedInputFile(png, "preview.png"),
            caption=preview_caption(PENDING[uid], s, meta),
            parse_mode="HTML", reply_markup=preview_kb("card"))
        PENDING[uid]["preview_id"] = ph.message_id
    except Exception as e:
        await msg.answer(f"⚠️ Превью не отрисовалось ({e}) — сразу в настройки")
        await show_settings(msg.chat.id, uid)

@dp.message(F.text)
async def on_text(msg: Message):
    uid = msg.from_user.id
    txt = (msg.text or "").strip()

    if uid in AWAIT_CODE:
        if txt.lower() in ("/cancel", "/отмена"):
            AWAIT_CODE.discard(uid)
            await msg.answer("❌ Ввод кода отменён")
            return
        if txt.startswith("/"):
            return
        if not txt or len(txt) > 32:
            await msg.answer("⚠️ Код: 1–32 символа одной строкой. Ещё раз (или /cancel):")
            return

        AWAIT_CODE.discard(uid)
        s = SETTINGS.setdefault(uid, DEFAULT.copy())
        s["const"], s["code"] = txt, "const"
        prefix = f"✅ Код «{escape(txt)}» задан\n\n"

        if uid in PENDING:
            await clear_markup(msg.chat.id, PENDING[uid].get("preview_id"))
            await show_settings(msg.chat.id, uid,
                                edit_id=PENDING[uid].get("menu_id"), prefix=prefix)
        else:
            await msg.answer(prefix + "Теперь пришли .dxf", parse_mode="HTML")
        return

    if txt.startswith("/"):
        return
    await msg.answer("Нажми ⚙️ / ⏭ под превью или 📄 / 📕 / 📦 в меню 👆"
                     if uid in PENDING else
                     "📐 Пришли .dxf — соберу ведомость координат")

@dp.callback_query(F.data)
async def on_btn(cb: CallbackQuery):
    uid, d = cb.from_user.id, cb.data

    if d.startswith("gen_"):       ack = "⏳ Готовлю файлы..."
    elif d.startswith("pv_skip"):  ack = "⏭ Пропускаю настройки"
    elif d.startswith("pv_render"): ack = "🔄 Рисую превью..."
    elif d.startswith("pv_cont"):  ack = "⚙️ Открываю настройки"
    else:                          ack = None
    await cb.answer(ack) if ack else await cb.answer()

    if d.startswith("pv_"):
        await handle_preview(cb, uid, d)
        return
    if d.startswith("gen_"):
        await generate_and_send(uid, d, cb.message.chat.id)
        return

    if uid not in PENDING:
        await bot.send_message(cb.message.chat.id, "⚠️ Данные уже выгружены, пришли .dxf заново")
        return

    s = SETTINGS.setdefault(uid, DEFAULT.copy())
    p = PENDING[uid]

    if d == "c_edit":
        AWAIT_CODE.add(uid)
        await cb.message.answer(
            "✏️ Отправь код одной строкой (<code>PL</code>, <code>1</code>, <code>ТЧК</code>) "
            "или /cancel:", parse_mode="HTML")
        return

    if d in CB_SEP:
        s["sep"] = CB_SEP[d]
    elif d == "c_none":   s["code"] = "none"
    elif d == "c_layer":  s["code"] = "layer"
    elif d == "c_const":  s["code"] = "const"
    elif d == "w_geo":    s["swap"] = True
    elif d == "w_cad":    s["swap"] = False
    elif d in ("d_2", "d_3", "d_4"):
        s["decimals"] = int(d[-1])

    if not p.get("menu_id"):
        await clear_markup(cb.message.chat.id, p.get("preview_id"))
    await show_settings(cb.message.chat.id, uid, edit_id=p.get("menu_id"))

