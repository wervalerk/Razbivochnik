# ================= DXF: помощники =================
def _entity_ocs(e):
    try:
        return e.ocs()                # повёрнутая ПСК (код 210)
    except Exception:
        return None

def _wcs(ocs, p):
    if ocs is not None:
        try:
            return ocs.to_wcs(p)
        except Exception:
            pass
    return p

def _lw_points(pl, use_ocs=True):
    """LWPOLYLINE: Z = elevation (код 38) на всю полилинию."""
    elev = float(pl.dxf.get("elevation", 0.0) or 0.0)
    ocs = _entity_ocs(pl) if use_ocs else None
    for x, y in pl.get_points("xy"):
        yield _wcs(ocs, Vec3(float(x), float(y), elev))

def _poly_type(pl):
    t = getattr(pl, "polyline_type", None)
    if callable(t):
        try:
            t = t()
        except Exception:
            t = None
    if t is not None:
        t = str(getattr(t, "name", t)).upper()
        if any(ch.isalpha() for ch in t):
            return t
    flags = int(pl.dxf.get("flags", 0) or 0)      # fallback: биты кода 70
    if flags & 64:
        return "POLYFACE"
    if flags & 16:
        return "POLYMESH"
    return "POLYLINE_3D" if (flags & 8) else "POLYLINE_2D"

def _poly_points(pl, ptype, use_ocs=True):
    """Настоящая 3D: у КАЖДОЙ VERTEX свой Z, координаты уже в WCS."""
    is_3d = ("3D" in ptype) and ("2D" not in ptype)
    ocs = None if (is_3d or not use_ocs) else _entity_ocs(pl)
    for v in pl.vertices:
        yield _wcs(ocs, v.dxf.location)

def _closed(pl):
    for attr in ("closed", "is_closed"):
        v = getattr(pl, attr, False)
        try:
            if bool(v() if callable(v) else v):
                return True
        except Exception:
            pass
    return False

def _walk_insert(ins, depth=0):
    if depth > 8:
        return
    for e in ins.virtual_entities():
        if e.dxftype() == "INSERT":
            yield from _walk_insert(e, depth + 1)
        else:
            yield e

def is_mesh(ptype):
    return any(k in ptype for k in ("POLYFACE", "POLYMESH", "MESH"))

# ================= DXF: сбор =================
def read_vertices(dxf_path):
    """-> (rows, stats, groups); groups = [(start, end, layer, closed), ...]"""
    doc = ezdxf.readfile(dxf_path)
    msp = doc.modelspace()
    rows, groups, n = [], [], 1
    stats = {"poly": 0, "spline": 0, "block": 0, "line": 0}

    def add(points, layer, closed=False):
        nonlocal n
        start = len(rows)
        for p in points:
            rows.append((n, float(p[0]), float(p[1]), float(p[2]), layer))
            n += 1
        if len(rows) > start:
            groups.append((start, len(rows), layer, closed))

    for pl in msp.query("LWPOLYLINE"):
        stats["poly"] += 1
        add(_lw_points(pl), pl.dxf.layer, _closed(pl))

    for pl in msp.query("POLYLINE"):          # в т.ч. 3D
        ptype = _poly_type(pl)
        if is_mesh(ptype):                   # иначе VERTEX-грани с (0,0,0)
            continue
        stats["poly"] += 1
        add(_poly_points(pl, ptype), pl.dxf.layer, _closed(pl))

    if INCLUDE_SPLINES:
        try:
            from ezdxf.path import make_path
        except ImportError as exc:
            raise RuntimeError("Для SPLINE/HELIX: pip install -U ezdxf") from exc
        for e in list(msp.query("SPLINE")) + list(msp.query("HELIX")):
            try:
                pts = list(make_path(e).flattening(0.01))
            except Exception:
                continue
            if pts:
                add(pts, e.dxf.layer)
                stats["spline"] += 1

    if INCLUDE_BLOCKS:
        for ins in msp.query("INSERT"):
            for e in _walk_insert(ins):
                dt = e.dxftype()
                if dt == "LWPOLYLINE":
                    add(_lw_points(e, False), e.dxf.layer, _closed(e))
                    stats["block"] += 1
                elif dt == "POLYLINE":
                    pt = _poly_type(e)
                    if not is_mesh(pt):
                        add(_poly_points(e, pt, False), e.dxf.layer, _closed(e))
                        stats["block"] += 1

    if INCLUDE_LINES:
        for e in msp.query("LINE"):
            add((e.dxf.start, e.dxf.end), e.dxf.layer)
            stats["line"] += 1
        for e in msp.query("POINT"):
            add((e.dxf.location,), e.dxf.layer)
            stats["line"] += 1

    return rows, stats, groups

# ======= Единый формат TXT / PDF =======
def header(s, for_pdf=False):
    rus = CYRILLIC or not for_pdf
    h = ["№", "X", "Y", "Z"] if rus else ["No", "X", "Y", "Z"]
    if s["code"] != "none":
        h.append("Код" if rus else "Code")
    return h

def format_row(rec, s, for_pdf=False):
    num, x, y, z, layer = rec
    X, Y = (y, x) if s["swap"] else (x, y)
    d = s["decimals"]
    out = [str(num), f"{X:.{d}f}", f"{Y:.{d}f}", f"{z:.{d}f}"]
    if s["code"] != "none":
        c = str(layer if s["code"] == "layer" else s["const"])
        c = c.replace("\r", " ").replace("\n", " ").strip()
        if for_pdf:
            c = pdf_safe(c)
        else:
            c = c.replace(s["sep"], "_")
            if s["sep"] in (" ", "\t"):
                c = c.replace(" ", "_").replace("\t", "_")
            if not c:
                c = "_"
        out.append(c)
    return out

def build_txt(rows, s):
    sep = s["sep"]
    lines = []
    # Для двойного клика в русском Excel (CREDO/pandas увидят лишнюю строку):
    # if sep == ",": lines.append("sep=,")
    lines.append(sep.join(header(s)))
    lines.extend(sep.join(format_row(r, s)) for r in rows)
    return "\n".join(lines) + "\n"

# ================= PDF =================
def build_pdf(rows, s, path):
    data = [header(s, True)] + [format_row(r, s, True) for r in rows]
    page_w = landscape(A4)[0]
    avail = page_w - 24 * mm

    doc = SimpleDocTemplate(
        path, pagesize=landscape(A4),
        leftMargin=rightMargin=12 * mm, topMargin=bottomMargin=12 * mm,
        title="Coordinate list", author="DXF bot",
    )
    title = "Ведомость координат" if CYRILLIC else "Coordinate list"
    info = (f"Точек: {len(rows)} | X=Север, Y=Восток | Z: WCS/elevation | Знаков: {s['decimals']}"
            if CYRILLIC else
            f"Points: {len(rows)} | X=North, Y=East | Z: WCS/elevation | Decimals: {s['decimals']}")
    if not s["swap"]:
        info = (info.replace("X=Север, Y=Восток", "как в AutoCAD")
                    .replace("X=North, Y=East", "as in AutoCAD"))

    cap = ParagraphStyle("cap", fontName=FONT, fontSize=10, leading=14)
    story = [Paragraph(f"<b>{title}</b><br/>{info}", cap), Spacer(1, 6 * mm)]

    weights = (0.08, 0.25, 0.25, 0.25, 0.17) if len(data[0]) == 5 else (0.10, 0.30, 0.30, 0.30)
    tbl = LongTable(data, colWidths=[avail * w for w in weights], repeatRows=1)
    tbl.setStyle(TableStyle([
        ("FONTNAME", (0, 0), (-1, -1), FONT),
        ("FONTSIZE", (0, 0), (-1, -1), 8),
        ("BACKGROUND", (0, 0), (-1, 0), colors.HexColor("#2F5597")),
        ("TEXTCOLOR", (0, 0), (-1, 0), colors.white),
        ("ALIGN", (0, 0), (-1, 0), "CENTER"),
        ("ALIGN", (0, 1), (0, -1), "CENTER"),
        ("ALIGN", (1, 1), (3, -1), "RIGHT"),
        ("VALIGN", (0, 0), (-1, -1), "MIDDLE"),
        ("GRID", (0, 0), (-1, -1), 0.25, colors.HexColor("#B4C6E7")),
        ("ROWBACKGROUNDS", (0, 1), (-1, -1),
         [colors.white, colors.HexColor("#F2F6FC")]),
        ("TOPPADDING", (0, 0), (-1, -1), 2.2),
        ("BOTTOMPADDING", (0, 0), (-1, -1), 2.2),
    ]))
    story.append(tbl)

    def footer(c, d_):
        c.saveState()
        c.setFont(FONT, 7)
        c.setFillColor(colors.grey)
        c.drawRightString(page_w - 12 * mm, 7 * mm, str(d_.page))
        c.restoreState()

    doc.build(story, onFirstPage=footer, onLaterPages=footer)

# ================= ПРЕВЬЮ (PNG) =================
def _pil_fonts():
    if FONT_FILE:
        return (ImageFont.truetype(FONT_FILE, 18),
                ImageFont.truetype(FONT_FILE, 14),
                ImageFont.truetype(FONT_FILE, 12))
    d = ImageFont.load_default()
    return d, d, d

def _txt(dr, xy, text, font, fill="#1B1B1B", stroke=True):
    try:
        dr.text(xy, text, fill=fill, font=font,
                stroke_width=2 if stroke else 0, stroke_fill="white")
    except TypeError:                      # старый Pillow
        dr.text(xy, text, fill=fill, font=font)

def render_preview(rows, groups, s, W=1200, H=800):
    """Картинка «как с экрана»: линии по слоям + точки с № из ведомости."""
    if not PIL_OK:
        raise RuntimeError("Pillow не установлен (pip install Pillow)")
    if not rows:
        raise RuntimeError("нет точек")

    f_title, f_small, f_num = _pil_fonts()
    img = Image.new("RGB", (W, H), "white")
    dr = ImageDraw.Draw(img)
    m = 68

    pts, zs = [], []
    for _, x, y, z, _ in rows:
        a, b = (y, x) if s["swap"] else (x, y)   # та же ориентация, что в TXT
        pts.append((a, b))
        zs.append(z)

    minx, maxx = min(p[0] for p in pts), max(p[0] for p in pts)
    miny, maxy = min(p[1] for p in pts), max(p[1] for p in pts)
    spanx, spany = (maxx - minx) or 1.0, (maxy - miny) or 1.0
    k = min((W - 2 * m) / spanx, (H - 2 * m) / spany)
    offx, offy = (W - spanx * k) / 2, (H - spany * k) / 2

    def scr(i):
        a, b = pts[i]
        return (offx + (a - minx) * k, H - offy - (b - miny) * k)

    # сетка + рамка
    for i in range(1, 5):
        gx, gy = m + i * (W - 2 * m) / 5, m + i * (H - 2 * m) / 5
        dr.line([(gx, m), (gx, H - m)], fill="#EEF2F8")
        dr.line([(m, gy), (W - m, gy)], fill="#EEF2F8")
    dr.rectangle([m, m, W - m, H - m], outline="#C9D6EA")

    palette = ["#2F5597", "#C00000", "#2E7D32", "#ED7D31",
               "#7030A0", "#00838F", "#7F6000", "#44546A"]
    layer_color = {}

    for st, en, layer, closed in groups:
        col = layer_color.setdefault(layer, palette[len(layer_color) % len(palette)])
        xy = [scr(i) for i in range(st, en)]
        if closed and len(xy) > 2:
            xy = xy + [xy[0]]               # только линия, НЕ новая точка
        if len(xy) > 1:
            try:
                dr.line(xy, fill=col, width=2, joint="curve")
            except TypeError:
                dr.line(xy, fill=col, width=2)

    n = len(rows)
    dot_step = max(1, math.ceil(n / 5000))
    step = max(1, math.ceil(n / 120))       # не подписываем все 20 000
    signed = 0
    for i in range(n):
        sx, sy = scr(i)
        if i % dot_step == 0:
            dr.ellipse((sx - 2.5, sy - 2.5, sx + 2.5, sy + 2.5), fill="#1B1B1B")
        if i % step == 0 or i == n - 1:
            _txt(dr, (sx + 5, sy - 15), str(rows[i][0]), f_num)
            signed += 1

    # легенда слоёв
    shown = list(layer_color.items())[:6]
    box_h = 44 + len(shown) * 20
    dr.rectangle([10, 10, 340, box_h], fill="white", outline="#C9D6EA")
    _txt(dr, (18, 15), img_text("Предпросмотр · № = № в TXT"), f_title, stroke=False)
    ly = 42
    for layer, col in shown:
        dr.rectangle([18, ly + 3, 30, ly + 13], fill=col)
        _txt(dr, (36, ly), img_text(layer)[:28], f_small, stroke=False)
        ly += 20

    # оси + подпись снизу
    dr.line([(m, H - m), (m + 40, H - m)], fill="#2F5597", width=2)
    dr.line([(m, H - m), (m, H - m - 40)], fill="#2F5597", width=2)
    _txt(dr, (m + 44, H - m - 10), img_text("Y →" if s["swap"] else "X →"), f_small, stroke=False)
    _txt(dr, (m + 6, H - m - 58), img_text("X ↑" if s["swap"] else "Y ↑"), f_small, stroke=False)
    _txt(dr, (18, H - 28),
         img_text(f"Точек: {n} | Z {min(zs):.2f}..{max(zs):.2f} | {spanx:.2f} x {spany:.2f}"),
         f_small, stroke=False)

    buf = io.BytesIO()
    img.save(buf, format="PNG")
    meta = {"step": step, "signed": signed, "zmin": min(zs), "zmax": max(zs),
            "spanx": spanx, "spany": spany, "layers": len(layer_color)}
    return buf.getvalue(), meta

