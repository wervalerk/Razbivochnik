    s = SETTINGS.setdefault(uid, DEFAULT.copy())
    rows, made, ok = p["rows"], [], False
    try:
        if mode in ("gen_txt", "gen_both"):
            fp = f"out_{uid}.txt"
            with open(fp, "w", encoding="utf-8-sig") as f:
                f.write(build_txt(rows, s))
            # хотите points.csv при запятой:
            # name = "points.csv" if s["sep"] == "," else "points.txt"
            made.append((fp, "points.txt"))

        if mode in ("gen_pdf", "gen_both"):
            fp = f"out_{uid}.pdf"
            build_pdf(rows, s, fp)
            made.append((fp, "points.pdf"))

        for fp, filename in made:
            note = "" if filename.endswith(".pdf") else f"Разделитель: {SEP_LONG[s['sep']]}\n"
            cap = (f"✅ Точек: {len(rows)}\n"
                   f"Колонки: {' '.join(header(s))}\n{note}"
                   f"Координаты: {'X=Север / Y=Восток' if s['swap'] else 'как в AutoCAD'}\n"
                   f"Z: из вершин 3D / elevation 2D")
            await bot.send_document(chat_id, FSInputFile(fp, filename=filename), caption=cap)
        ok = True
    except Exception as e:
        await bot.send_message(chat_id, f"❌ Ошибка генерации: {e}")
    finally:
        for fp, _ in made:
            if os.path.exists(fp):
                os.remove(fp)
        if ok:
            await clear_markup(chat_id, p.get("preview_id"))
            mid = p.get("menu_id")
            if mid:
                try:
                    await bot.edit_message_text(
                        "✅ Готово. Пришли новый .dxf 👇",
                        chat_id=chat_id, message_id=mid, reply_markup=EMPTY_KB)
                except Exception:
                    await clear_markup(chat_id, mid)
            else:
                await bot.send_message(chat_id, "✅ Готово. Пришли новый .dxf 👇")
            PENDING.pop(uid, None)       # настройки НЕ трогаем

async def handle_preview(cb, uid, data):
    action, _, ctx = data.partition(":")
    p = PENDING.get(uid)
    if not p:
        await bot.send_message(cb.message.chat.id, "⚠️ Данные уже выгружены, пришли .dxf заново")
        return
    chat_id = cb.message.chat.id
    s = SETTINGS.setdefault(uid, DEFAULT.copy())

    if action == "pv_render":
        await drop_preview(uid, chat_id)                 # старую картинку убираем
        try:
            png, meta = render_preview(p["rows"], p["groups"], s)
        except Exception as e:
            await bot.send_message(chat_id, f"⚠️ Превью не отрисовалось: {e}")
            return
        ph = await bot.send_photo(
            chat_id=chat_id,
            photo=BufferedInputFile(png, "preview.png"),
            caption=preview_caption(p, s, meta), parse_mode="HTML",
            reply_markup=preview_kb(ctx))
        p["preview_id"] = ph.message_id
        return

    if action == "pv_cont":
        await clear_markup(chat_id, p.get("preview_id"))   # картинку оставляем
        if ctx == "menu" and p.get("menu_id"):
            return                                          # меню уже открыто выше
        await show_settings(chat_id, uid)
        return

    if action == "pv_skip":
        await clear_markup(chat_id, p.get("preview_id"))
        await generate_and_send(uid, "gen_txt", chat_id)    # сразу файл, без меню

