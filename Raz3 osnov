def register_font():
    here = os.path.dirname(os.path.abspath(__file__))
    for p in (
        os.path.join(here, "DejaVuSans.ttf"),
        os.path.join(here, "fonts", "DejaVuSans.ttf"),
        "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
        "C:/Windows/Fonts/arial.ttf",
    ):
        if os.path.exists(p):
            try:
                pdfmetrics.registerFont(TTFont("Geo", p))
                return "Geo", True, p
            except Exception:
                continue
    return "Helvetica", False, None

FONT, CYRILLIC, FONT_FILE = register_font()

def pdf_safe(v):
    if CYRILLIC:
        return str(v)
    return str(v).encode("ascii", "ignore").decode() or "LAYER"

def img_text(v):
    v = str(v)
    return v if FONT_FILE else (v.encode("ascii", "ignore").decode() or "LAYER")

